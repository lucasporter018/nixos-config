{
  "layer": "top",
  "height": 30,
  "margin-top": 5,
  "margin-left": 5,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "custom/spotify", "custom/bluetooth", "cpu", "memory", "custom/temperature", "custom/power"],

  "hyprland/workspaces": {
    "format": "{}",
    "on-click": "hyprctl dispatch workspace {}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %b %d, %Y %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#D8DEE9'><b>{}</b></span>",
        "days": "<span color='#E5E9F0'>{}</span>",
        "weeks": "<span color='#4C566A'><b>W{}</b></span>",
        "weekdays": "<span color='#81A1C1'><b>{}</b></span>",
        "today": "<span color='#88C0D0'><b><u>{}</u></b></span>"
      }
    }
  },

  "pulseaudio": {
    "format": " \u202f{volume}%",
    "format-muted": " muted",
    "on-click": "pamixer -t"
  },

  // "custom/spotify": {
  //   "format": "{icon} {}",
  //   "escape": true,
  //   "return-type": "json",
  //   "max-length": 40,
  //   "interval": 30, 
  //   "on-click": "playerctl -p spotify play-pause",
  //   "on-click-right": "killall spotify",
  //   "smooth-scrolling-threshold": 10,
  //   "on-scroll-up" : "playerctl -p spotify next",
  //   "on-scroll-down" : "playerctl -p spotify previous",
  //   "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null", 
  //   "exec-if": "pgrep spotify"
  //  },
  
  "custom/bluetooth": {
    "exec": "~/.config/waybar/bluetooth-status.sh",
    "on-click": "~/.config/waybar/bluetooth-menu.sh",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/bluetooth-menu.xml",
    "menu-actions": {
      "airpods": "~/.config/waybar/bluetooth-handle-selection.sh airpods",
      "sonos": "~/.config/waybar/bluetooth-handle-selection.sh sonos",
      "keyboard": "~/.config/waybar/bluetooth-handle-selection.sh keyboard",
      "audio_settings": "pavucontrol"
    },
    "menu-offset-y":20,
    "interval": 5,
    "return-type": "json"
  },

  "cpu": {
    "interval": 3,
    "format": " {usage}%"
  },

  "memory": {
    "interval": 5,
    "format": " {}%"
  },

  // "custom/temperature": {
  //   "interval": 5,
  //   "format": "{}\u202f",
  //   "exec": "~/.config/waybar/temperature.sh",
  //   "return-type": "json"
  // },

//   "custom/power": {
